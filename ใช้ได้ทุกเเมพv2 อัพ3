    else
        AntiLagBtn.Text = "OFF"
        AntiLagBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        AntiLagBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        restoreAntiLag()
    end
end)

local removeEffectsEnabled = false
local removeEffectsConn = nil
local disabledEffects = {}

local function cleanEffect(v)
    if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("Trail") or v:IsA("Highlight") then
        if v.Enabled then
            disabledEffects[v] = true
            v.Enabled = false
        end
    end
end

local function restoreEffects()
    for v, _ in pairs(disabledEffects) do
        if v and v.Parent then
            v.Enabled = true
        end
    end
    table.clear(disabledEffects)
end

