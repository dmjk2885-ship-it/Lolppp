    if equipCooldownEnabled then
        local function processTools(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    item.Enabled = true
                    pcall(function()
                        if item.Cooldown then item.Cooldown = 0 end
                    end)
                    for _, val in ipairs(item:GetDescendants()) do
                        if val:IsA("NumberValue") or val:IsA("IntValue") then
                            if string.lower(val.Name):find("cooldown") or string.lower(val.Name):find("cd") then
                                val.Value = 0
                            end
                        end
                    end
                end
            end
        end
        processTools(LocalPlayer.Character)
        processTools(LocalPlayer:FindFirstChild("Backpack"))
    end
end)

