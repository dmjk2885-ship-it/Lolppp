local function getClosestPlayerRoot()
    local closestTarget = nil
    local shortestDist = math.huge
    local localChar = LocalPlayer.Character
    local myRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))

    if not myRoot then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")

            if hum and hum.Health > 0 and root and root ~= myRoot then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = root
                end
            end
        end
    end
    return closestTarget
end

local function getFarthestPlayerRoot()
    local farthestTarget = nil
    local longestDist = -1
    local localChar = LocalPlayer.Character
    local myRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))

    if not myRoot then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")

            if hum and hum.Health > 0 and root and root ~= myRoot then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist > longestDist then
                    longestDist = dist
                    farthestTarget = root
                end
            end
        end
    end
    return farthestTarget
end

local function teleportFacingTarget(targetRoot)
    local char = LocalPlayer.Character
    local myRoot = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if myRoot and targetRoot then
        local targetPos = targetRoot.Position
        local offsetPos = targetPos + (targetRoot.CFrame.LookVector * -3) + Vector3.new(0, 2, 0)
        myRoot.CFrame = CFrame.lookAt(offsetPos, targetPos)
        return true
    end
    return false
end

