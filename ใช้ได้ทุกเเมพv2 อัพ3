local originalPartData = {}
local originalDecalData = {}
local originalLightingData = {}

local function applyAntiLag()
    originalLightingData.GlobalShadows = Lighting.GlobalShadows
    originalLightingData.FogEnd = Lighting.FogEnd
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        originalLightingData.WaterWaveSize = terrain.WaterWaveSize
        originalLightingData.WaterWaveSpeed = terrain.WaterWaveSpeed
        originalLightingData.WaterReflectance = terrain.WaterReflectance
        originalLightingData.WaterTransparency = terrain.WaterTransparency

        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 0
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            if not originalPartData[v] then
                originalPartData[v] = {Material = v.Material, CastShadow = v.CastShadow}
            end
            v.Material = Enum.Material.SmoothPlastic
            v.CastShadow = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            if not originalDecalData[v] then
                originalDecalData[v] = {Transparency = v.Transparency}
            end
            v.Transparency = 1
        end
    end
end

local function restoreAntiLag()
    if originalLightingData.GlobalShadows ~= nil then Lighting.GlobalShadows = originalLightingData.GlobalShadows end
    if originalLightingData.FogEnd ~= nil then Lighting.FogEnd = originalLightingData.FogEnd end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        if originalLightingData.WaterWaveSize ~= nil then terrain.WaterWaveSize = originalLightingData.WaterWaveSize end
        if originalLightingData.WaterWaveSpeed ~= nil then terrain.WaterWaveSpeed = originalLightingData.WaterWaveSpeed end
        if originalLightingData.WaterReflectance ~= nil then terrain.WaterReflectance = originalLightingData.WaterReflectance end
        if originalLightingData.WaterTransparency ~= nil then terrain.WaterTransparency = originalLightingData.WaterTransparency end
    end

    for part, data in pairs(originalPartData) do
        if part and part.Parent then
            part.Material = data.Material
            part.CastShadow = data.CastShadow
        end
    end
    table.clear(originalPartData)

    for decal, data in pairs(originalDecalData) do
        if decal and decal.Parent then
            decal.Transparency = data.Transparency
        end
    end
    table.clear(originalDecalData)
end

AntiLagBtn.MouseButton1Click:Connect(function()
    antiLagEnabled = not antiLagEnabled
